---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Speaking | Ravikumar Buragapu"
			description="Conference talks, interviews, and speaking topics covering production AI, agentic systems, platform engineering, developer productivity, and operational resilience."
		/>
	</head>
	<body>
		<Header />
		<main>
			<header>
				<h1>Speaking</h1>
				<p>
					I speak about the engineering challenges behind emerging
					technologies—from building productive engineering platforms
					to operating reliable, secure AI systems at scale.
				</p>
				<p>
					My focus is on the decisions that turn promising ideas into
					production systems: architecture, evaluation, security,
					operational resilience, and measurable engineering outcomes.
				</p>
			</header>

			<section aria-labelledby="featured-talks">
				<h2>Selected talks and conference appearances</h2>
				<ul>
					<li>
						<strong>DPE Summit 2023</strong>
						<p>
							Unlocking High-Velocity Development Strategies,
							Tactics, and Metrics.
						</p>
						<a
							href="https://dpe.org/sessions/ravikumar-buragapu/unlocking-high-velocity-development-strategies-tactics-and-metrics/"
							target="_blank"
							rel="noopener noreferrer"
						>
							View session and materials
						</a>
					</li>
					<li>
						<strong>ScyllaDB Summit 2023</strong>
						<p>
							Conference presentation on database and
							distributed-systems engineering.
						</p>
						<a
							href="https://www.youtube.com/watch?v=4k1R8uST-9M"
							target="_blank"
							rel="noopener noreferrer"
						>
							Watch session
						</a>
					</li>
					<li>
						<strong>Percona Community Live 2022</strong>
						<p>Database Resiliency.</p>
						<a
							href="https://percona.community/events/percona-community-live-2022/day-1-ravikumar-buragapu/"
							target="_blank"
							rel="noopener noreferrer"
						>
							View session
						</a>
					</li>
					<li>
						<strong>Artificial Intelligence and Machine Learning Conference</strong>
						<p>Santa Clara, 2019.</p>
						<a
							href="https://www.youtube.com/watch?v=D47lUHx6VVI"
							target="_blank"
							rel="noopener noreferrer"
						>
							Watch panel discussion
						</a>
					</li>
					<li>
						<strong>Global Artificial Intelligence Conference</strong>
						<p>
							AI / ML in Data Science Engineering &amp;
							Operational Excellence.
						</p>
						<a
							href="https://www.globalbigdataconference.com/seattle/global-artificial-intelligence-conference-115/speaker-details/ravi-kumar-buragapu-73271.html"
							target="_blank"
							rel="noopener noreferrer"
						>
							View speaker profile
						</a>
					</li>
					<li>
						<strong>Inspired AI / World Summit AI</strong>
						<p>
							AI industry speaker profile and related event information.
						</p>
						<a
							href="https://inspired-minds.co.uk/inspired-ai-speakers/"
							target="_blank"
							rel="noopener noreferrer"
						>
							View speaker listing
						</a>
					</li>
				</ul>
			</section>

			<section aria-labelledby="interviews">
				<h2 id="interviews">Interviews</h2>
				<ul>
					<li>
						<a
							href="https://www.youtube.com/watch?v=ZbuXy1aPo-8"
							target="_blank"
							rel="noopener noreferrer"
						>
							DPE Summit interview with Ravikumar Buragapu
						</a>
					</li>
				</ul>
			</section>

			<section aria-labelledby="speaking-topics">
				<h2 id="speaking-topics">Speaking topics</h2>
				<p>
					I welcome opportunities to speak at engineering conferences,
					leadership forums, podcasts, and academic events on topics
					such as:
				</p>
				<ul>
					<li>
						<strong>The Hard Part of Agents Isn't the Model</strong>
						<p>
							Why production agent systems depend on identity,
							permissions, evaluation, observability, cost controls,
							and operational accountability—not just model quality.
						</p>
					</li>
					<li>
						<strong>Earning Agentic Autonomy</strong>
						<p>
							How evaluation evidence, error budgets, policy
							enforcement, and runtime controls can determine
							which actions an AI agent is allowed to take.
						</p>
					</li>
					<li>
						<strong>Engineering Reliable AI Systems</strong>
						<p>
							Building the operational foundations for AI in
							production, including monitoring, failure recovery,
							human oversight, and measurable service objectives.
						</p>
					</li>
					<li>
						<strong>AI-Native Platform Engineering</strong>
						<p>
							How internal developer platforms, AI-assisted
							workflows, reusable engineering capabilities,
							and guardrails can improve developer productivity
							without sacrificing security or quality.
						</p>
					</li>
					<li>
						<strong>Developer Productivity: From Metrics to Outcomes</strong>
						<p>
							Moving beyond activity-based metrics to understand
							developer experience, software delivery performance,
							and the organizational conditions for high-velocity
							engineering.
						</p>
					</li>
					<li>
						<strong>Operational Resilience for Data-Intensive Systems</strong>
						<p>
							Engineering for high availability, observability,
							capacity, incident response, and recovery across
							complex enterprise platforms.
						</p>
					</li>
				</ul>
			</section>

			<section aria-labelledby="invite">
				<h2 id="invite">Invite me to speak</h2>
				<p>
					I'm open to conversations with conference organizers,
					engineering communities, podcast hosts, and academic
					programs interested in production AI, platform engineering,
					reliability, and the future of software engineering.
				</p>
				<p>
					For speaking invitations and collaboration, please
					<a href="/about">learn more about my background</a>
					or get in touch by email.
				</p>
			</section>

			<section aria-labelledby="related-writing">
				<h2 id="related-writing">Related writing</h2>
				<p>
					Explore my articles on agentic systems, engineering
					productivity, and production AI.
					<a href="/writing">Read the articles</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>