---
import Project from '../../layouts/Project.astro';

const repo = 'https://github.com/buragapuravi/my_research_work/tree/main/rag-judge-eval';

// When reviewers finish labeling and you have real agreement numbers, add them here.
// Keep each line factual and include the setup, for example:
// const findings = [
//   'Across [N] labeled cases, the rubric-based judge reached Cohen's κ of [X] with human reviewers, versus [Y] for the naive judge.',
// ];
// const caveat = 'Based on a [N]-case sample; not representative of multi-hop or numeric questions.';
const findings = undefined;
const caveat = undefined;
---

<Project
	title="Validated RAG Eval Harness"
	description="A human-validated harness for measuring LLM-as-judge agreement on RAG answers and citation support."
	tag="RAG RESEARCH · EVALUATION · HUMAN VALIDATION"
	intro="Does LLM-as-judge agree with human reviewers on RAG answer correctness and citation support? Compare naive, rubric-based, and stepwise judge prompts against independent human labels."
	status="Harness ready · human labels pending"
	stack="Python · pytest · OpenAI API"
	repo={repo}
	findings={findings}
	caveat={caveat}
>
	<section aria-labelledby="measures">
		<h2 id="measures">Measure agreement—not just model scores</h2>
		<ul>
			<li>Three-class answer labels: correct, partially correct, or wrong.</li>
			<li>Separate binary judgments for whether cited passages support the answer.</li>
			<li>Nominal Cohen's κ, raw agreement, confusion counts, and per-type disagreements.</li>
			<li>Judge cost from provider token usage and optional human labor cost.</li>
		</ul>
		<p>
			Human labels are blank until reviewers complete them.
			The included 50-case fixture is illustrative and cannot
			establish agreement or represent multi-hop, numeric, or
			negation question performance.
		</p>
	</section>

	<section aria-labelledby="run">
		<h2 id="run">Prepare independent human labels first</h2>
		<pre><code>cd rag-judge-eval
python -m venv .venv
source .venv/bin/activate
pip install -e ".[dev]"
pytest
rag-judge-eval prepare
# Complete results/human-review.csv before seeing judge outputs.
export OPENAI_API_KEY="..."
rag-judge-eval run --model gpt-4o-mini</code></pre>
		<p>
			<a href={repo} target="_blank" rel="noopener noreferrer">Read the project README</a>{' '}
			·{' '}
			<a href="/projects/chunking-ablation">Explore Chunking Strategy Ablation</a>
		</p>
	</section>
</Project>