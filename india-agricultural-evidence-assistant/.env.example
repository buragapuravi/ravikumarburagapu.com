RAG_FRAMEWORK=llamaindex
VECTOR_BACKEND=chroma
CHROMA_PATH=data/index/chroma
CHROMA_COLLECTION=agri_evidence
RAW_DATA_DIR=data/raw
DEMO_DATA_DIR=data/demo
MANIFEST_PATH=data/index/ingestion-manifest.json

# Local multilingual embedding model; download and warm it before a live demo.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
HF_HUB_OFFLINE=1

# Disabled reranking avoids a second model download. Set to a CrossEncoder model to enable.
RERANKER_MODEL=
RERANK_TOP_K=8
DENSE_TOP_K=12
LEXICAL_TOP_K=12
EVIDENCE_MIN_SCORE=0.08
EVIDENCE_MIN_COVERAGE=0.15
MAX_OFFICIAL_SOURCE_AGE_DAYS=365

# Provider is "ollama", "openai-compatible", or "none". No provider is needed to launch.
LLM_PROVIDER=none
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180

# Used only by the optional Ragas diagnostic evaluator.
RAGAS_LLM_PROVIDER=none
RAGAS_MODEL=
RAGAS_BASE_URL=
RAGAS_API_KEY=
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_TIMEOUT_SECONDS=45
POSTGRES_PASSWORD=change-me
POSTGRES_DSN=postgresql://postgres:change-me@localhost:5432/agri_evidence
